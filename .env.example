# `real` sends all inference to a remote Wan2.2/ComfyUI worker. `mock` only tests
# the backend media pipeline; it copies source segments and does not replace a character.
MODE=real
# Base URL for any reachable compatible ComfyUI server (no trailing slash).
# Examples: http://127.0.0.1:8188 or https://comfyui.example.net
COMFYUI_URL=http://127.0.0.1:8188
# Local path on the FastAPI machine to the API-format Wan2.2 Animate Mix workflow.
WAN_WORKFLOW_PATH=workflow/wan22_animate_mix_api.json
# Local persistent storage for uploads, intermediate segments, and final videos.
STORAGE_DIR=data/jobs
# Shorter segments reduce peak VRAM. The preflight check may lower this automatically.
MAX_SEGMENT_SECONDS=4.0
# Generated clips are normalized to this maximum long side. Both dimensions become multiples of 16.
MAX_GENERATION_SIDE=512
SEGMENT_RETRIES=2
